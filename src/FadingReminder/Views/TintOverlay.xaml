<Window x:Class="FadingReminder.Views.TintOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TintOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="True"
        Loaded="Window_Loaded">

    <Grid x:Name="OverlayGrid" MouseDown="OverlayGrid_MouseDown">
        <!-- The tint rectangle -->
        <Rectangle x:Name="TintRectangle"
                   Fill="Navy"
                   Opacity="0.4"/>

        <!-- Message display with time and custom message -->
        <Border x:Name="MessageBorder"
                Background="#CC000000"
                CornerRadius="15"
                Padding="50,40"
                MaxWidth="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Opacity="0.6"
                                  BlurRadius="20"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="CurrentTimeText"
                           Text="12:00 PM"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="MessageText"
                           Text="Time to rest your eyes!"
                           FontSize="28"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="800"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="DismissText"
                           Text="Click anywhere to dismiss"
                           FontSize="14"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
