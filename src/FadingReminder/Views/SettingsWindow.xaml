<Window x:Class="FadingReminder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FadingReminder - Settings"
        Height="550"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Settings Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Tint Color Section -->
                <GroupBox Header="Tint Color (M)" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="Color (Hex ARGB):"/>
                                <TextBox x:Name="ColorTextBox"
                                         Text="#80000080"
                                         TextChanged="ColorTextBox_TextChanged"/>

                                <TextBlock Text="Example: #80FF0000 (semi-transparent red)"
                                           FontSize="10"
                                           Foreground="Gray"
                                           Margin="5,2,5,5"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    x:Name="ColorPreview"
                                    Background="Navy"
                                    BorderBrush="Gray"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    Margin="10,25,5,5"
                                    Height="50"/>
                        </Grid>

                        <!-- Predefined Colors -->
                        <Label Content="Quick Colors:" Margin="5,10,5,0"/>
                        <WrapPanel Margin="5">
                            <Button Content="Red" Width="60" Margin="2" Click="QuickColor_Click" Tag="#80FF0000"/>
                            <Button Content="Green" Width="60" Margin="2" Click="QuickColor_Click" Tag="#8000FF00"/>
                            <Button Content="Blue" Width="60" Margin="2" Click="QuickColor_Click" Tag="#800000FF"/>
                            <Button Content="Yellow" Width="60" Margin="2" Click="QuickColor_Click" Tag="#80FFFF00"/>
                            <Button Content="Orange" Width="60" Margin="2" Click="QuickColor_Click" Tag="#80FF8800"/>
                            <Button Content="Purple" Width="60" Margin="2" Click="QuickColor_Click" Tag="#80800080"/>
                            <Button Content="Navy" Width="60" Margin="2" Click="QuickColor_Click" Tag="#80000080"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Interval Section -->
                <GroupBox Header="Tint Interval (N)" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="Tint every (minutes):"/>
                                <TextBox x:Name="IntervalTextBox"
                                         Text="20"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="minutes"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,5,10"
                                       FontSize="14"
                                       Foreground="Gray"/>
                        </Grid>

                        <TextBlock Text="Range: 1-120 minutes"
                                   FontSize="10"
                                   Foreground="Gray"
                                   Margin="5,2,5,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Display Options -->
                <GroupBox Header="Display Options" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Custom Message:"/>
                        <TextBox x:Name="CustomMessageTextBox"
                                 Text="Time to rest your eyes!"
                                 MaxLength="100"
                                 Margin="0,0,0,10"/>
                        <TextBlock Text="This message will be shown with the current time on the tint overlay"
                                   FontSize="10"
                                   Foreground="Gray"
                                   Margin="5,0,5,10"/>

                        <Label Content="Tint Duration (seconds):"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="DurationTextBox"
                                     Text="3"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"/>

                            <TextBlock Grid.Column="1"
                                       Text="seconds"
                                       VerticalAlignment="Center"
                                       Margin="10,0,5,0"
                                       FontSize="14"
                                       Foreground="Gray"/>
                        </Grid>

                        <Label Content="Tint Opacity:" Margin="0,10,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    x:Name="OpacitySlider"
                                    Minimum="0.2"
                                    Maximum="0.8"
                                    Value="0.4"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"/>
                        </Grid>

                        <CheckBox x:Name="ShowOnAllMonitorsCheckBox"
                                  Content="Show tint on all monitors"
                                  Margin="5,15,5,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Application Options -->
                <GroupBox Header="Application Options" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <CheckBox x:Name="EnableTintingCheckBox"
                                  Content="Enable periodic tinting"
                                  Margin="5"
                                  IsChecked="True"/>

                        <CheckBox x:Name="AutoStartCheckBox"
                                  Content="Start with Windows"
                                  Margin="5"
                                  Checked="AutoStartCheckBox_Changed"
                                  Unchecked="AutoStartCheckBox_Changed"/>

                        <CheckBox x:Name="StartMinimizedCheckBox"
                                  Content="Start minimized to tray"
                                  Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Test Button -->
                <Button x:Name="TestTintButton"
                        Content="Test Tint Now"
                        Click="TestTintButton_Click"
                        Padding="15,8"
                        Margin="5"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Click="SaveButton_Click"
                    Width="100"
                    Height="35"
                    Margin="5,0"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="35"
                    Margin="5,0"
                    Background="#757575"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
