<Window x:Class="FadingReminder.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FadingReminder - Manage Reminders"
        Height="600"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Manage Reminders"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Info Text -->
        <TextBlock Grid.Row="1"
                   Text="Set up to 10 reminders for today and 10 for tomorrow. Each reminder will show a screen tint with your message."
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,15"/>

        <!-- Tabs -->
        <TabControl Grid.Row="2" x:Name="ReminderTabs">
            <!-- Today Tab -->
            <TabItem Header="Today" FontSize="14" FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel x:Name="TodayRemindersPanel">
                        <!-- Reminder slots will be added programmatically -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tomorrow Tab -->
            <TabItem Header="Tomorrow" FontSize="14" FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel x:Name="TomorrowRemindersPanel">
                        <!-- Reminder slots will be added programmatically -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="SaveButton"
                    Content="Save All"
                    Click="SaveButton_Click"
                    Width="100"
                    Height="35"
                    Margin="5,0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="35"
                    Margin="5,0"
                    Background="#757575"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
